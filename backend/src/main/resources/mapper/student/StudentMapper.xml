<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.chordsked.backend.dao.mapper.StudentMapper">

    <sql id="StudentColumns">
        id,
        name,
        age,
        level,
        created_at,
        updated_at
    </sql>

    <sql id="StudentWhere">
        <where>
            <if test="keyword != null and keyword != ''">
                AND name LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="level != null and level != ''">
                AND level = #{level}
            </if>
        </where>
    </sql>

    <select id="listStudents" resultType="com.chordsked.backend.model.entity.StudentEntity">
        SELECT
        <include refid="StudentColumns"/>
        FROM student
        <include refid="StudentWhere"/>
        ORDER BY id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countStudents" resultType="long">
        SELECT COUNT(1)
        FROM student
        <include refid="StudentWhere"/>
    </select>

</mapper>
