<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chordsked.backend.dao.mapper.UserCampusMapper">

    <select id="selectPrimaryCampusIdByUserId" resultType="long">
        SELECT campus_id
        FROM sys_user_campus
        WHERE user_id = #{userId}
          AND is_primary = 1
        LIMIT 1
    </select>

</mapper>
